{
  "name": "leeds-harvester",
  "version": "0.2.0",
  "description": "Self-hosted web scraping workspace: turn public websites into structured data with runs, tasks, cron schedules and JSON/CSV export.",
  "keywords": [
    "web-scraping",
    "scraper",
    "crawler",
    "data-extraction",
    "lead-generation",
    "contact-extractor",
    "metadata",
    "seo",
    "self-hosted",
    "nodejs",
    "react",
    "sqlite"
  ],
  "homepage": "https://github.com/KritishX/leeds-harvester-web-scraper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KritishX/leeds-harvester-web-scraper.git"
  },
  "bugs": {
    "url": "https://github.com/KritishX/leeds-harvester-web-scraper/issues"
  },
  "author": "Kritish Dhital",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1 --port 4180",
    "dev:server": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "cheerio": "^1.1.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
